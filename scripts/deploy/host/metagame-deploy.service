[Unit]
Description=METAGAME 백엔드 배포 (스풀의 jar 을 적용하고 헬스체크·롤백)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
# deploy.sh 가 스스로 RELEASE 를 지우므로 path 유닛이 다시 무장한다.
ExecStart=/home/ubuntu/metagame/deploy/deploy.sh
TimeoutStartSec=600
# 배포 스크립트는 실패도 STATUS 로 보고하고 0 으로 끝난다 — 유닛 실패 상태를 남기지 않는다.
