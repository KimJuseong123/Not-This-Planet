[Unit]
Description=METAGAME EC2 상태 재기 — 결과를 배포 스풀에 JSON 한 장으로 놓는다 (S15P21B202-458)
Documentation=https://lab.ssafy.com/s15-metaverse-game-sub1/S15P21B202/-/blob/develop/docs/records/S15P21B202-458-ec2-health.md

[Service]
Type=oneshot
# root 로 돈다 — 인증서(/etc/letsencrypt)가 root 만 읽을 수 있다.
ExecStart=/opt/metagame-deploy/ec2-status.sh
# **실패를 성공으로 치지 않는다.** 한때 `SuccessExitStatus=0 1` 이었는데, 그러면
# JSON 이 깨져 exit 1 로 끝나도 `systemctl` 과 저널에 정상으로 보인다 — 재는 쪽이
# 계속 실패해도 카드는 "오래된 값" 이라고만 말하고 원인을 못 찾는다.
# 실패해도 시스템은 안 막힌다(타이머가 5분 뒤 다시 돈다).
TimeoutStartSec=60
