# 러너 호스트의 Claude 액세스 토큰을 주기적으로 갱신한다 (S15P21B202-304)
#
# 왜 필요한가
#   ai-review 는 러너 호스트에 로그인된 Claude CLI 자격을 잡 컨테이너에 **읽기 전용**으로
#   마운트해 쓴다(-290). 그런데 **액세스 토큰 수명이 8시간**이고, 만료되면 CLI 가 리프레시
#   토큰으로 새 토큰을 받아 `~/.claude/.credentials.json` 에 **쓴다.**
#   컨테이너는 :ro 라 그 쓰기를 못 한다 → 401 authentication → 리뷰가 통째로 실패한다
#   (2026-09-04 실측: 만료 09:04 UTC · 실패한 잡 09:20 UTC).
#
#   그래서 갱신을 **호스트가** 한다. 컨테이너는 읽기만 하고, 자격은 항상 유효한 상태로 있다.
#   :rw 로 되돌리면 아무 MR 잡이나 팀 자격증명을 읽고 덮어쓸 수 있게 되므로(-252 와 같은 종류)
#   그 길은 쓰지 않는다.
#
# 소유권 주의
#   잡 컨테이너는 **root** 로 돈다. :rw 였을 때 컨테이너가 갱신을 쓰면 파일이 root:root 600 이
#   되고, 그 뒤로 호스트의 ubuntu 는 자기 자격을 읽지도 못한다(2026-09-04 실제로 그랬다).
#   이 유닛은 ubuntu 로 돌아 소유권을 유지한다. root 는 어차피 남의 600 파일도 읽으므로
#   컨테이너 쪽 읽기에는 문제가 없다.
#
# 설치:
#   sudo chown -R ubuntu:ubuntu /home/ubuntu/.claude     # 컨테이너가 가져간 소유권 되돌리기
#   sudo cp scripts/runner/claude-token-refresh.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now claude-token-refresh.timer
#
# 확인:
#   systemctl list-timers claude-token-refresh
#   journalctl -u claude-token-refresh -n 20
#
# 되돌리기:
#   sudo systemctl disable --now claude-token-refresh.timer

[Unit]
Description=러너 호스트의 Claude 액세스 토큰 갱신 (S15P21B202-304)
Documentation=https://ssafy.atlassian.net/browse/S15P21B202-304

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu
# 한 마디 물어보는 것만으로 CLI 가 만료된 액세스 토큰을 리프레시 토큰으로 갈아 준다.
# 출력은 버린다 — 로그에 남길 값이 없고, 자격 관련 문자열이 섞일 여지도 주지 않는다.
ExecStart=/bin/sh -c '/usr/local/bin/claude -p PONG > /dev/null 2>&1 && echo "토큰 갱신 OK" || echo "토큰 갱신 실패 — 러너 호스트에서 claude 재로그인이 필요할 수 있다"'
TimeoutStartSec=180
