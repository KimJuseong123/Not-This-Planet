# claude-token-refresh.service 를 주기적으로 돌린다 (S15P21B202-304 · -309 · -310)
#
# 주기: **1분** (S15P21B202-381). 처음에는 3시간(-304), 그다음 20분(-309)이었다.
# 액세스 토큰 수명이 8시간이니 넉넉하다고 봤는데
# **틀렸다.** CLI 는 **만료된 뒤에만** 토큰을 갈아 준다 — 2026-09-06 EC2 실측: 만료까지
# 2.8시간 남은 상태에서 `claude -p` 를 돌려도 .credentials.json 의 mtime 이 바뀌지 않았다.
# 그래서 **타이머 주기가 그대로 최대 무응답 구간**이 된다. 3시간이던 동안 !229 의 ai-review 가
# 08:34 UTC 에 401 로 죽고 08:48 틱 뒤에야 살아났다(-309).
#
# 8시간 TTL 을 아무리 자주 두드려도 만료 직후의 구멍 자체는 없앨 수 없다 — 갱신 시점을 CLI 가
# 정하기 때문이다. 줄일 수만 있다. 그래서 1분이다.
#
# **1분 틱이 하루 1440번 호출은 아니다.** 그랬다면 이 주기를 쓸 수 없다 — `claude -p` 는
# CPU 가 아니라 **팀 구독 사용량**이고, 6명이 쓰는 구독을 점검이 그만큼 먹는 것은 답이
# 아니다. 틱은 `.credentials.json` 의 `claudeAiOauth.expiresAt` 을 **읽기만** 한다.
# 실제 호출은 **만료된 뒤**와 **2시간마다 생존 확인** 때뿐이라 하루 15번 남짓이고,
# 이것은 20분 주기(72번)보다 **적다.** 판정은 claude_auth_check.should_call 에 있다.
#
# 알림 문턱은 이제 **경과 시간**이다(-381) — 예전에는 틱 횟수였고, 그래서 이 주기를
# 바꾸면 알림 시점이 같이 움직였다. 지금은 틱 주기와 무관하다.
#
# 부팅 뒤에도 한 번 돌린다 — 오래 꺼져 있었으면 그 사이 만료됐을 수 있다.

[Unit]
Description=Claude 자격 갱신·점검 타이머 (S15P21B202-304 · -310)
Documentation=https://ssafy.atlassian.net/browse/S15P21B202-310

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
# 1분 주기에 1분 정확도를 두면 systemd 가 틱을 뭉쳐 실제 간격이 벌어진다.
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
