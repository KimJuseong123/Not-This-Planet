# 로컬 개발용 환경변수 예시
#
# 사용법: 이 파일을 backend/.env 로 복사한 뒤 값을 채운다. (.env 는 git에 커밋되지 않는다)
#   cp .env.example .env
# 서버 실행 시 backend/.env 를 자동으로 읽는다 (application.yml 의 spring.config.import).
# 환경변수로 직접 주입해도 되며, 그쪽이 우선한다.
#
# 아래 두 값은 기본값이 없다. 비어 있으면 애플리케이션이 부팅에 실패한다.

# docker-compose.yml 로 띄운 로컬 MySQL 의 비밀번호와 같아야 한다
DB_PASSWORD=metagame1234

# HS256 서명 키(base64, 32바이트 이상). 아래 값은 로컬 개발 전용이다.
# 배포 시에는 반드시 새로 생성해 서버 환경변수로만 주입할 것:
#   PowerShell:  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Linux/macOS: openssl rand -base64 48
JWT_SECRET=puycjARxAUZCfWqAIIukuAu7HG1kr34iIjFZoRLuhxMY2wAVNvD987ST4KQTtDc1

# --- 아래는 선택 항목. 비우면 application.yml 의 기본값을 쓴다 ---
# DB_URL=jdbc:mysql://localhost:3306/metagame?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=metagame
# SERVER_PORT=8080
# JWT_ACCESS_TOKEN_VALIDITY_MS=86400000
# GAME_RECONNECT_GRACE_MS=30000
