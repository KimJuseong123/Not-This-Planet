#!/bin/sh
# ------------------------------------------------------------------
# pre-push: ① Jira 이슈 키가 없는 브랜치의 push를 로컬에서 막고(안내용),
#           ② git-lfs 의 pre-push 훅을 이어서 실행한다(LFS 오브젝트 업로드).
#
# 왜 ②가 필요한가: `git config core.hooksPath .githooks` 를 켜면 git 은 이 디렉터리의 훅만 실행하고
#   `git lfs install` 이 .git/hooks/pre-push 에 넣어 둔 LFS 훅은 실행되지 않는다. 그러면 LFS 오브젝트가
#   올라가지 않아 서버가 "GitLab: LFS objects are missing" 으로 push 를 거부한다(S15P21B202-81).
#
# 설정 (클론 후 1회):  git config core.hooksPath .githooks
# 허용 브랜치명:
#   master, develop
#   <JIRA키>-<번호>-<설명>              예) S15P21B202-12-player-jump
#   hotfix/<JIRA키>-<번호>-<설명>       예) hotfix/S15P21B202-40-crash-on-join
# 최종 방어는 서버가 아니라 CI(mr-lint) 이다 — 이 훅은 가장 빨리 알려 주는 안내.
# 근거: docs/git-convention.md §3, §6
# ------------------------------------------------------------------
PATTERN='^(master|develop|(hotfix/)?[A-Z][A-Z0-9]+-[0-9]+(-[A-Za-z0-9._-]+)?)$'
ZERO=0000000000000000000000000000000000000000
status=0

# stdin(푸시할 ref 목록)은 한 번만 읽을 수 있으므로 보관해 두고 LFS 훅에 그대로 넘긴다
input=$(cat)

printf '%s\n' "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # 브랜치 삭제 push는 통과
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;                                # 태그 등은 통과
  esac
  branch=${remote_ref#refs/heads/}
  if ! printf '%s' "$branch" | grep -Eq "$PATTERN"; then
    echo "" >&2
    echo "✗ push 거부: 브랜치명 '$branch' 에 Jira 이슈 키가 없습니다." >&2
    echo "  브랜치는 Jira 이슈 화면의 '브랜치 만들기'로 생성하세요." >&2
    echo "  형식: <JIRA키>-<번호>-<영문설명>   예) S15P21B202-12-player-jump" >&2
    echo "  (feature/ 같은 접두어는 쓰지 않습니다 — docs/git-convention.md §3)" >&2
    echo "" >&2
    exit 1
  fi

  # 참고 경고(차단 아님, S15P21B202-110): 원격에 없는 브랜치를 다시 만드는 push 인데
  # 예전에 push 한 적이 있으면(upstream 설정이 남아 있으면) 머지 후 자동 삭제된 브랜치를 되살리는 것일 수 있다.
  # 그 경우 MR 도 파이프라인도 없이 조용히 남으므로 알려 준다(2026-08-28 실제 유실 사고).
  # 주의: 브랜치를 origin/develop 에서 만들면 upstream 이 refs/heads/develop 로 자동 설정된다.
  # 그러므로 "upstream 이 **자기 이름**을 가리키는 경우"(= 예전에 push -u 로 올린 적이 있는 브랜치)만 본다.
  upstream=$(git config --get "branch.${branch}.merge" 2>/dev/null)
  if [ "$remote_sha" = "$ZERO" ] && [ "$upstream" = "refs/heads/${branch}" ]; then
    echo "" >&2
    echo "⚠ 원격에 이 브랜치가 없습니다 — 이전에 push 한 브랜치라면 MR 머지 후 자동 삭제된 것일 수 있습니다." >&2
    echo "  머지된 뒤의 후속 작업은 **새 이슈 · 새 브랜치**로 하세요. 이대로 push 하면 MR 도 파이프라인도 없이" >&2
    echo "  브랜치만 되살아나 아무도 모르게 남습니다(2026-08-28 실제로 수정 5건이 이렇게 유실됨)." >&2
    echo "" >&2
  fi

  # 참고 경고(차단 아님, S15P21B202-90): 브랜치가 develop 이 아닌 곳에서 갈라졌는지 —
  # 이미 가져와 둔 원격 추적 참조만 보므로 네트워크 접근이 없다. master 는 develop 의 조상이라
  # develop 기준 merge-base 와 master 기준 merge-base 가 같으면 master 시점(또는 그 이전)에서 갈라진 것.
  case "$branch" in
    master|develop|hotfix/*) ;;
    *)
      if git rev-parse -q --verify origin/develop >/dev/null 2>&1 && git rev-parse -q --verify origin/master >/dev/null 2>&1; then
        base_dev=$(git merge-base "$local_sha" origin/develop 2>/dev/null)
        base_master=$(git merge-base "$local_sha" origin/master 2>/dev/null)
        dev_head=$(git rev-parse origin/develop 2>/dev/null)
        if [ -n "$base_dev" ] && [ "$base_dev" = "$base_master" ] && [ "$base_dev" != "$dev_head" ]; then
          echo "" >&2
          echo "⚠ 이 브랜치는 develop 이 아니라 master(또는 그 이전)에서 갈라진 것으로 보입니다." >&2
          echo "  최신 씬·에셋·스크립트가 없는 코드일 수 있습니다 — develop 에서 브랜치를 새로 만들거나" >&2
          echo "  'git fetch && git rebase origin/develop' 후 작업하세요. (hotfix/ 는 master 기반이 정상)" >&2
          echo "  push 는 계속 진행됩니다. MR 을 만들면 CI(mr-lint)도 같은 경고를 남깁니다." >&2
          echo "" >&2
        fi
      fi
      ;;
  esac
done || status=1
[ "$status" -ne 0 ] && exit "$status"

# ② git-lfs pre-push (설치돼 있을 때만). 실패하면 push 도 실패해야 LFS 누락 커밋이 서버에 올라가지 않는다
if command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$input" | git lfs pre-push "$@"
  exit $?
fi
echo "ℹ git-lfs 가 설치되어 있지 않아 LFS 훅을 건너뜁니다 — 바이너리 에셋을 올린다면 git-lfs 를 설치하고 'git lfs install' 을 실행하세요." >&2
exit 0
