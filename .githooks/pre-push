#!/bin/sh
# ------------------------------------------------------------------
# pre-push: ① Jira 이슈 키가 없는 브랜치의 push를 로컬에서 막고(안내용),
#           ② push 전에 develop 최신을 얹어 주고(자동 리베이스, S15P21B202-137),
#           ③ git-lfs 의 pre-push 훅을 이어서 실행한다(LFS 오브젝트 업로드).
#
# 왜 ②가 필요한가: `git config core.hooksPath .githooks` 를 켜면 git 은 이 디렉터리의 훅만 실행하고
#   `git lfs install` 이 .git/hooks/pre-push 에 넣어 둔 LFS 훅은 실행되지 않는다. 그러면 LFS 오브젝트가
#   올라가지 않아 서버가 "GitLab: LFS objects are missing" 으로 push 를 거부한다(S15P21B202-81).
#
# 설정 (클론 후 1회):  git config core.hooksPath .githooks
# 허용 브랜치명:
#   master, develop
#   <JIRA키>-<번호>-<설명>              예) S15P21B202-12-player-jump
#   hotfix/<JIRA키>-<번호>-<설명>       예) hotfix/S15P21B202-40-crash-on-join
# 최종 방어는 서버가 아니라 CI(mr-lint) 이다 — 이 훅은 가장 빨리 알려 주는 안내.
# 근거: docs/git-convention.md §3, §6
# ------------------------------------------------------------------
PATTERN='^(master|develop|(hotfix/)?[A-Z][A-Z0-9]+-[0-9]+(-[A-Za-z0-9._-]+)?)$'
ZERO=0000000000000000000000000000000000000000
status=0

# stdin(푸시할 ref 목록)은 한 번만 읽을 수 있으므로 보관해 두고 LFS 훅에 그대로 넘긴다
input=$(cat)

printf '%s\n' "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # 브랜치 삭제 push는 통과
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;                                # 태그 등은 통과
  esac
  branch=${remote_ref#refs/heads/}
  if ! printf '%s' "$branch" | grep -Eq "$PATTERN"; then
    echo "" >&2
    echo "✗ push 거부: 브랜치명 '$branch' 에 Jira 이슈 키가 없습니다." >&2
    echo "  브랜치는 Jira 이슈 화면의 '브랜치 만들기'로 생성하세요." >&2
    echo "  형식: <JIRA키>-<번호>-<영문설명>   예) S15P21B202-12-player-jump" >&2
    echo "  (feature/ 같은 접두어는 쓰지 않습니다 — docs/git-convention.md §3)" >&2
    echo "" >&2
    exit 1
  fi

  # 참고 경고(차단 아님, S15P21B202-110): 원격에 없는 브랜치를 다시 만드는 push 인데
  # 예전에 push 한 적이 있으면(upstream 설정이 남아 있으면) 머지 후 자동 삭제된 브랜치를 되살리는 것일 수 있다.
  # 그 경우 MR 도 파이프라인도 없이 조용히 남으므로 알려 준다(2026-08-28 실제 유실 사고).
  # 주의: 브랜치를 origin/develop 에서 만들면 upstream 이 refs/heads/develop 로 자동 설정된다.
  # 그러므로 "upstream 이 **자기 이름**을 가리키는 경우"(= 예전에 push -u 로 올린 적이 있는 브랜치)만 본다.
  upstream=$(git config --get "branch.${branch}.merge" 2>/dev/null)
  if [ "$remote_sha" = "$ZERO" ] && [ "$upstream" = "refs/heads/${branch}" ]; then
    echo "" >&2
    echo "⚠ 원격에 이 브랜치가 없습니다 — 이전에 push 한 브랜치라면 MR 머지 후 자동 삭제된 것일 수 있습니다." >&2
    echo "  머지된 뒤의 후속 작업은 **새 이슈 · 새 브랜치**로 하세요. 이대로 push 하면 MR 도 파이프라인도 없이" >&2
    echo "  브랜치만 되살아나 아무도 모르게 남습니다(2026-08-28 실제로 수정 5건이 이렇게 유실됨)." >&2
    echo "" >&2
  fi

  # 참고 경고(차단 아님, S15P21B202-90): 브랜치가 develop 이 아닌 곳에서 갈라졌는지 —
  # 이미 가져와 둔 원격 추적 참조만 보므로 네트워크 접근이 없다. master 는 develop 의 조상이라
  # develop 기준 merge-base 와 master 기준 merge-base 가 같으면 master 시점(또는 그 이전)에서 갈라진 것.
  case "$branch" in
    master|develop|hotfix/*) ;;
    *)
      if git rev-parse -q --verify origin/develop >/dev/null 2>&1 && git rev-parse -q --verify origin/master >/dev/null 2>&1; then
        base_dev=$(git merge-base "$local_sha" origin/develop 2>/dev/null)
        base_master=$(git merge-base "$local_sha" origin/master 2>/dev/null)
        dev_head=$(git rev-parse origin/develop 2>/dev/null)
        if [ -n "$base_dev" ] && [ "$base_dev" = "$base_master" ] && [ "$base_dev" != "$dev_head" ]; then
          echo "" >&2
          echo "⚠ 이 브랜치는 develop 이 아니라 master(또는 그 이전)에서 갈라진 것으로 보입니다." >&2
          echo "  최신 씬·에셋·스크립트가 없는 코드일 수 있습니다 — develop 에서 브랜치를 새로 만들거나" >&2
          echo "  'git fetch && git rebase origin/develop' 후 작업하세요. (hotfix/ 는 master 기반이 정상)" >&2
          echo "  push 는 계속 진행됩니다. MR 을 만들면 CI(mr-lint)도 같은 경고를 남깁니다." >&2
          echo "" >&2
        fi
      fi
      ;;
  esac
done || status=1
[ "$status" -ne 0 ] && exit "$status"

# ------------------------------------------------------------------
# ② push 전 develop 최신 반영 (S15P21B202-137)
#   왜: fetch → rebase 를 습관으로 갖고 있지 않아도 그 과정이 자동으로 붙게 한다.
#       뒤처진 브랜치로 계속 작업하면 씬·프리팹이 겹칠 때 충돌하거나 최신 작업을 덮어쓴다.
#   제약: 훅이 도는 시점에 git 은 보낼 커밋을 이미 확정했다. 그래서 여기서 리베이스한 뒤에는
#       이번 push 를 중단하고 다시 push 하도록 안내한다(팀원이 하는 일은 `git push` 한 번 더).
#   막지 않는 것: 충돌로 자동 리베이스가 안 되면 원상복구하고 경고만 남긴다 — push 는 계속된다.
#   끄기·바꾸기:
#         METAGAME_AUTOREBASE=0            이 단계 전체를 건너뜀
#         METAGAME_AUTOREBASE_FETCH=0      가져오기 없이 이미 받아 둔 origin/develop 기준으로만 판단
#         METAGAME_AUTOREBASE_MODE=merge   리베이스 대신 merge 로 얹는다(커밋 해시가 그대로라 강제 push 가 필요 없다).
#                                          씬·프리팹을 많이 만지는 작업은 이쪽이 편하다 — 충돌을 한 번에 본다
#                                          (docs/git-convention.md §2-4 의 권고와 같은 이유)
# ------------------------------------------------------------------
cur=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
head_sha=$(git rev-parse HEAD 2>/dev/null || echo "")
pushing_cur=$(printf '%s\n' "$input" | awk -v b="refs/heads/$cur" -v h="$head_sha" '$3==b && $2==h {print "yes"}' | head -1)

autorebase_busy() {   # 리베이스·머지·체리픽 중이면 손대지 않는다
  d=$(git rev-parse --git-dir 2>/dev/null) || return 0
  [ -d "$d/rebase-merge" ] || [ -d "$d/rebase-apply" ] || [ -f "$d/MERGE_HEAD" ] || [ -f "$d/CHERRY_PICK_HEAD" ]
}

stacked_parent() {    # 이 브랜치가 얹혀 있는 다른 작업 브랜치(origin) 이름 — 없으면 빈 문자열
  # 끝 커밋이 HEAD 의 조상이면서 origin/develop 의 조상은 아닌 원격 작업 브랜치 = 부모.
  # 스택 브랜치를 develop 위로 옮기면 부모 커밋이 복제되어 스택이 깨지므로(S15P21B202-138 과 조율) 자동 반영을 건너뛴다.
  for ref in $(git for-each-ref --format='%(refname:short)' refs/remotes/origin/ 2>/dev/null); do
    name=${ref#origin/}
    case "$name" in "$1"|develop|master|HEAD) continue ;; esac
    if git merge-base --is-ancestor "$ref" HEAD 2>/dev/null && ! git merge-base --is-ancestor "$ref" origin/develop 2>/dev/null; then
      echo "$name"; return 0
    fi
  done
  return 1
}

if [ "${METAGAME_AUTOREBASE:-1}" != "0" ] && [ -n "$cur" ] && [ "$pushing_cur" = "yes" ] && ! autorebase_busy; then
  case "$cur" in
    master|develop|hotfix/*) ;;                   # hotfix 는 master 기반이 정상, 보호 브랜치는 대상 아님
    *)
      if [ "${METAGAME_AUTOREBASE_FETCH:-1}" != "0" ]; then
        git fetch -q origin develop 2>/dev/null \
          || echo "ℹ origin/develop 을 가져오지 못했습니다(오프라인?) — 이미 받아 둔 참조로 판단합니다." >&2
      fi
      if git rev-parse -q --verify origin/develop >/dev/null 2>&1; then
        behind=$(git rev-list --count HEAD..origin/develop 2>/dev/null || echo 0)
        ahead=$(git rev-list --count origin/develop..HEAD 2>/dev/null || echo 0)
        parent=$(stacked_parent "$cur")
        if [ -n "$parent" ] && [ "${behind:-0}" -gt 0 ]; then
          echo "" >&2
          echo "ℹ 이 브랜치는 '$parent' 위에 얹혀 있어(스택 MR) develop 자동 반영을 건너뜁니다 — 부모가 먼저 develop 최신을 얹으면 그 위에서 따라갑니다:" >&2
          echo "      git fetch origin $parent && git rebase origin/$parent" >&2
          echo "" >&2
        elif [ "${behind:-0}" -gt 0 ] && [ "${ahead:-0}" -gt 0 ]; then
          mode=${METAGAME_AUTOREBASE_MODE:-rebase}
          echo "" >&2
          if [ "$mode" = "merge" ]; then
            echo "↻ develop 이 ${behind}커밋 앞서 있습니다 — push 전에 자동으로 merge 합니다." >&2
            if git stash push -q -u -m "pre-push automerge" >/dev/null 2>&1; then stashed=yes; else stashed=no; fi
            if git merge --no-edit -q origin/develop >/dev/null 2>&1; then
              [ "$stashed" = yes ] && git stash pop -q >/dev/null 2>&1
              echo "✓ merge 완료 — develop 최신 ${behind}커밋을 얹었습니다. 커밋 해시는 그대로라 강제 push 가 필요 없습니다." >&2
              echo "" >&2
              echo "  이번 push 는 중단했습니다(git 은 push 직전에 보낼 커밋을 이미 확정합니다)." >&2
              echo "  아래 명령으로 다시 push 하세요." >&2
              echo "" >&2
              echo "      git push" >&2
              echo "" >&2
              exit 1
            fi
            git merge --abort >/dev/null 2>&1
            [ "$stashed" = yes ] && git stash pop -q >/dev/null 2>&1
            echo "⚠ 자동 merge 가 충돌로 멈춰 원래 상태로 되돌렸습니다 — 작업 내용은 그대로입니다." >&2
            echo "  직접 정리해 주세요:  git fetch origin develop && git merge origin/develop" >&2
            echo "  push 는 계속 진행합니다. 이 상태로 MR 을 만들면 GitLab 이 충돌을 표시하고 팀장이 머지할 수 없습니다." >&2
            echo "" >&2
          else
            echo "↻ develop 이 ${behind}커밋 앞서 있습니다 — push 전에 자동으로 리베이스합니다." >&2
            if git rebase --autostash origin/develop >/dev/null 2>&1; then
              echo "✓ 리베이스 완료 — develop 최신 ${behind}커밋을 얹었습니다. 작업 내용은 그대로입니다." >&2
              echo "" >&2
              echo "  이번 push 는 중단했습니다: 리베이스로 커밋 해시가 바뀌었는데, git 은 push 직전에" >&2
              echo "  보낼 커밋을 이미 확정했기 때문입니다. 아래 명령으로 다시 push 하세요." >&2
              if git rev-parse -q --verify "origin/$cur" >/dev/null 2>&1; then
                echo "" >&2
                echo "      git push --force-with-lease" >&2
                echo "" >&2
                echo "  (이미 올라가 있는 브랜치라 강제 push 가 필요합니다. --force-with-lease 는 그 사이" >&2
                echo "   남이 올린 커밋이 있으면 거부하므로 남의 작업을 덮어쓰지 않습니다." >&2
                echo "   MR 이 열려 있으면 파이프라인이 다시 돕니다.)" >&2
              else
                echo "" >&2
                echo "      git push -u origin HEAD" >&2
              fi
              echo "" >&2
              exit 1
            fi
            git rebase --abort >/dev/null 2>&1
            echo "⚠ 자동 리베이스가 충돌로 멈춰 원래 상태로 되돌렸습니다 — 작업 내용은 그대로입니다." >&2
            echo "  씬·프리팹 충돌이면 merge 로 한 번에 보는 쪽이 편합니다(컨벤션 §2-4):" >&2
            echo "      git fetch origin develop && git merge origin/develop" >&2
            echo "  다음부터 merge 로 자동 반영하려면:  git config --global alias.p '!METAGAME_AUTOREBASE_MODE=merge git push'" >&2
            echo "  push 는 계속 진행합니다. 이 상태로 MR 을 만들면 GitLab 이 충돌을 표시하고 팀장이 머지할 수 없습니다." >&2
            echo "" >&2
          fi
        fi
      fi
      ;;
  esac
fi

# ③ git-lfs pre-push (설치돼 있을 때만). 실패하면 push 도 실패해야 LFS 누락 커밋이 서버에 올라가지 않는다
if command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$input" | git lfs pre-push "$@"
  exit $?
fi
echo "ℹ git-lfs 가 설치되어 있지 않아 LFS 훅을 건너뜁니다 — 바이너리 에셋을 올린다면 git-lfs 를 설치하고 'git lfs install' 을 실행하세요." >&2
exit 0
