#!/bin/sh
# ------------------------------------------------------------------
# pre-push: Jira 이슈 키가 없는 브랜치의 push를 로컬에서 막는다.
# (서버의 보호 브랜치 규칙도 같은 이름을 거부하므로, 이 훅은 친절한 안내용)
#
# 설정 (클론 후 1회):  git config core.hooksPath .githooks
# 허용 브랜치명:
#   master, develop
#   <JIRA키>-<번호>-<설명>              예) S15P21B202-12-player-jump
#   hotfix/<JIRA키>-<번호>-<설명>       예) hotfix/S15P21B202-40-crash-on-join
# 근거: docs/git-convention.md §3, §6
# ------------------------------------------------------------------
PATTERN='^(master|develop|(hotfix/)?[A-Z][A-Z0-9]+-[0-9]+(-[A-Za-z0-9._-]+)?)$'
ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # 브랜치 삭제 push는 통과
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;                                # 태그 등은 통과
  esac
  branch=${remote_ref#refs/heads/}
  if ! printf '%s' "$branch" | grep -Eq "$PATTERN"; then
    echo "" >&2
    echo "✗ push 거부: 브랜치명 '$branch' 에 Jira 이슈 키가 없습니다." >&2
    echo "  브랜치는 Jira 이슈 화면의 '브랜치 만들기'로 생성하세요." >&2
    echo "  형식: <JIRA키>-<번호>-<영문설명>   예) S15P21B202-12-player-jump" >&2
    echo "  (feature/ 같은 접두어는 쓰지 않습니다 — docs/git-convention.md §3)" >&2
    echo "" >&2
    status=1
  fi
done
exit $status
