MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1476801186}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b6cf7c72dc4be240a51c77679d3f73f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Metagame.Gameplay::Metagame.Gameplay.AuthoredMapSettings
  playerSpawn: {fileID: 1162930807}
  flightHalfSize: {x: 90, y: 75}
  maximumAltitude: 20
  preserveSceneLighting: 1
  randomizeVehicles: 0
  explorationClues:
  - "\uB0A8\uC11C \uBB3C\uB958\uC7A5. \uC2DC\uB8CC \uC6B4\uBC18\uC744 \uB9C8\uCE58\uACE0
    \uCDA9\uC804 \uC911\uC774\uB358 \uD558\uC5ED \uB85C\uBD07\uC774\uB2E4. \uC8FC\uD669
    \uACE0\uC815\uBABB\uC744 \uD480\uACE0 \uB113\uC740 \uBB3C\uB958\uB3C4\uB85C\uB85C
    \uC911\uC559 \uC870\uB9BD\uB300\uC5D0 \uBC18\uD658\uD55C\uB2E4."
  - "\uBD81\uC11C \uB300\uAE30 \uAD00\uCE21\uC18C. \uD638\uBC84 \uD3EC\uB4DC\uAC00
    \uACE0\uB3C4\uBCC4 \uB300\uAE30 \uC2DC\uB8CC\uB97C \uC218\uC9D1\uD558\uACE0 \uC788\uC5C8\uB2E4.
    \uC6B4\uC11D\uC5D0 \uB04A\uAE34 \uACC4\uB2E8 \uB300\uC2E0 \uB3CC\uBD80\uB9AC\uB85C
    \uC62C\uB77C, \uC190\uC7A1\uC774\uB85C \uD654\uBB3C\uB300\uB97C \uB0B4\uB824
    \uBC18\uD658\uD55C\uB2E4."
  - "\uBD81\uB3D9 \uC2DC\uB8CC \uACA9\uB9AC\uC2E4. \uC870\uC885\uC11D \uCEA1\uC290\uC744
    \uBC00\uD3D0 \uAD00\uCE21\uC2E4\uB85C \uC0AC\uC6A9\uD588\uB2E4. \uBBF8\uD68C\uC218
    \uC9C0\uC9C8 \uC870\uC0AC \uC7A5\uC57D\uC740 \uD0D0\uC0C9\uAE30\uB85C \uD53C\uD574
    \uAC04\uB2E4. \uC804\uB825 \uB2E4\uC774\uC5BC\uC744 \uB9DE\uCD94\uACE0 \uB3D9\uB8CC\uAC00
    \uBE44\uC0C1 \uC548\uC804 \uBC1C\uD310\uC744 \uBC1F\uC73C\uBA74 \uBC18\uCD9C\uD560
    \uC218 \uC788\uB2E4."
  - "\uB0A8\uB3D9 \uCC44\uAD74 \uC815\uBE44\uC18C. \uACAC\uC778 \uAE30\uCCB4\uAC00
    \uC606\uC73C\uB85C \uB204\uC6CC \uC218\uB9AC \uC911\uC774\uC5C8\uB2E4. \uC6B4\uC11D\uC73C\uB85C
    \uB300\uD615 \uCD9C\uC785\uAD6C\uAC00 \uB9C9\uD614\uB2E4. \uB0AE\uC740 \uBCF4\uC870
    \uD1B5\uB85C\uB85C \uD568\uAED8 \uAD74\uB824 \uBC18\uCD9C\uD55C\uB2E4. \uC5F0\uB8CC\uC640
    \uACAC\uC778\uC740 \uC120\uD0DD \uC0AC\uD56D\uC774\uB2E4."
