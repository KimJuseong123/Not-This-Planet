# 이 파일을 서버의 .env로 복사하고 CHANGE_ME 값을 모두 교체한다.
# 운영·개발 DB/JWT 비밀은 서로 다르게 만든다. 실제 값은 Git에 넣지 않는다.
DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
JWT_SECRET=CHANGE_ME_STANDARD_BASE64_48_RANDOM_BYTES
RELAY_PROVIDER=local
RELAY_CONTROL_URL=http://host.docker.internal:17779
RELAY_PUBLIC_ADDRESS=CHANGE_ME_PUBLIC_DNS
RELAY_ALWAYS=true
CLIENT_MIN_VERSION=
CLIENT_DOWNLOAD_URL=https://CHANGE_ME_PUBLIC_DNS/play/
RUNLOG_KEEP_DAYS=14
JWT_ACCESS_TOKEN_VALIDITY_MS=86400000
GAME_RECONNECT_GRACE_MS=30000
