<Project Sdk="Microsoft.NET.Sdk">

  <!--
    런처 빌드 설정 (S15P21B202-406).

    **이 파일은 한 번도 커밋된 적이 없었다** (S15P21B202-475 · -456 을 재다 발견). 저장소 루트
    `.gitignore` 의 `*.csproj` — Unity 가 다시 만드는 프로젝트 파일을 걸러내려던 규칙 —
    이 이것까지 삼켰다. 그래서 README 는 `dotnet publish` 를 하라고 적어 두었는데
    **아무도 런처를 빌드할 수 없었다.** 실수로 지우면 다시 같은 일이 나므로,
    `.gitignore` 에 이 폴더를 되살리는 줄을 함께 넣었다.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 코드가 `using System;`·`System.Linq` 를 적지 않는다 — 암시적 using 전제다. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 사이트가 가리키는 이름·nginx 허용 목록·publish_launcher.PUBLIC_NAME 과 같아야 한다. -->
    <AssemblyName>NotThisPlanetLauncher</AssemblyName>
    <RootNamespace>NotThisPlanet.Launcher</RootNamespace>

    <!--
      **받는 사람에게 .NET 설치를 요구하지 않는다.** 그것을 요구하면 런처가 없애려던
      수동 절차가 그대로 남는다. 그래서 self-contained 단일 파일이다.
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!--
      트리밍으로 70.2 MB → 14.4 MB. **소스 생성기로 JSON 을 읽게 바꾼 뒤에만 안전하다**
      (`JsonContext.cs`) — 기본 `JsonSerializer` 경로는 리플렉션을 쓰므로 트리머가
      프로퍼티를 지워도 **빌드는 통과하고 실행만 조용히 깨진다.** 런처가 조용히 깨지면
      사용자는 원인을 알 수 없다.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <!--
      **리플렉션 JSON 을 아예 끈다.** 위 위험을 주석이 아니라 빌드가 막게 한다 —
      누가 `JsonSerializer.Deserialize<T>(…)` 를 쓰면 그 자리에서 경고가 난다.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- 지역화 데이터를 빼 크기를 줄인다. 코드는 전부 `StringComparison.Ordinal` 이다. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      트리밍·단일 파일 경고를 실수로 지나치지 않는다. **분석기를 켜는 것만으로는
      부족하다** — IL2xxx·IL3xxx 는 경고라서 빌드 로그를 스쳐 지나가고, 그 결과가
      바로 위에 적은 "빌드는 통과하고 실행만 조용히 깨진다" 이다.

      **왜 전체(`TreatWarningsAsErrors`)가 아니라 이 목록인가.** 런처는 CI 에서 빌드하지
      않으므로(-406) 전체로 올리면, SDK 가 새 경고를 들고 왔을 때 **릴리스 직전 한 사람의
      PC 에서** 빌드가 선다. 발견 시점으로는 가장 나쁜 자리다. 그런데 그 경고 대부분은
      사용자에게 아무 일도 일으키지 않는다(권장 문법·사용 중단 안내 따위).

      트리밍 경고는 다르다. 그것을 놓치면 **런처가 조용히 깨지고, 깨진 런처는 자기를
      고칠 수 없다** — 자기 갱신이 바로 그 깨진 코드다. 그래서 여기만 에러로 올린다.

      **이 목록은 범주가 아니라 목록이다.** 새 IL 코드가 생기면 여기 없다. 단단한 보증은
      위의 `JsonSerializerIsReflectionEnabledByDefault=false` 쪽이고, 이것은 그 위에 덧대는
      그물이다. 2026-09-13 `-warnaserror` 로 경고 0 을 확인했다.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2055;IL2057;IL2060;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3000;IL3002;IL3050;IL3053</WarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!--
      `dotnet publish -c Release -p:Version=1.0.1` 로 박는다. `SelfUpdate.MyVersion` 이
      `AssemblyInformationalVersion` 을 읽어 서버의 `launcher.json` 과 견준다.

      **기본값을 그럴듯한 수로 두지 않는다.** 예전에는 `1.0.0` 이었는데, 그러면
      `-p:Version=` 을 빠뜨렸을 때 **진짜 같은 버전이 조용히 나온다**(2026-09-13 실측:
      인자 없이 publish 하면 `v1.0.0`). 그 exe 를 v1.0.1 로 올리면 서버는 1.0.1 이라
      하고 exe 는 자기를 1.0.0 으로 보므로, 받는 사람은 **켤 때마다 갱신을 시도하고
      받아도 여전히 1.0.0 이다** — 끝나지 않는다.
    -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!--
    그리고 그 실수를 **빌드가 막는다.** 주석으로 적어 두는 것으로는 부족하다 —
    빠뜨리는 것은 바쁠 때이고, 그때 주석을 읽지 않는다.

    개발 중 `dotnet build`·`dotnet run` 은 그대로 된다. 막는 것은 **배포용 publish** 뿐이다.
  -->
  <Target Name="RequireExplicitVersionOnRelease" BeforeTargets="Publish"
          Condition="'$(Configuration)' == 'Release' AND '$(Version)' == '0.0.0-dev'">
    <Error Text="릴리스 publish 에는 버전이 필요합니다: dotnet publish -c Release -p:Version=1.0.1 (지금은 기본값 0.0.0-dev 라, 이대로 올리면 런처가 끝나지 않는 자기 갱신에 빠집니다 — S15P21B202-475)" />
  </Target>

</Project>
