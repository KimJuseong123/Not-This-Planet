# Unity YAML assets stay as text for review and merge visibility.
*.unity text
*.prefab text
*.asset text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.meta text
*.inputactions text
*.asmdef text
*.json text

# Large binary assets use Git LFS.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.3ds filter=lfs diff=lfs merge=lfs -text
