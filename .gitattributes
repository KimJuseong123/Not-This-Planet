# Scripts: shell/python always LF (Linux runner), PowerShell CRLF
# 확장자가 없는 훅 파일은 *.sh 에 걸리지 않는다 — 윈도우에서 core.autocrlf=true 로 CRLF 가 되고,
# 리눅스에서 실행하면 셰방이 '/bin/sh' 이 되어 'No such file or directory' 로 죽는다(2026-09-01 실측).
/.githooks/** text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf

# 굽힌 춤 클립만 LFS (S15P21B202-563 · -576). 다른 .anim 은 작아서 text 로 둔다 — 위의
# `*.anim text` 는 리뷰·머지 가시성 때문인데, 이 파일은 생성물이라 그 값이 없다.
# 원본은 Tools/Blender/data/rabbit_dance_bichon.json 과 generate_rabbit_dance.py 이고
# 둘 다 읽을 수 있는 텍스트다. 이 클립은 427프레임 x 18뼈라 11MB 이고 비-LFS 한도는 5MB 다.
METAGAME/Assets/_Project/Animations/Characters/Rabbit/Resources/RabbitLocomotion/Rabbit_Dance.anim filter=lfs diff=lfs merge=lfs -text
METAGAME/Assets/_Project/Animations/Characters/Rabbit/Resources/RabbitLocomotion/Rabbit_RedRed.anim filter=lfs diff=lfs merge=lfs -text

# Stage1 scene exceeds the repository's 5 MiB non-LFS limit.
METAGAME/Assets/Scenes/Stage1_Astra.unity filter=lfs diff=lfs merge=lfs -text
