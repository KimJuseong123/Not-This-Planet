*.prefab text
*.asset text
*.mat text
*.terrainlayer text
*.anim text
*.controller text
*.overrideController text
*.meta text
*.inputactions text
*.asmdef text
*.json text

# Stage1 Astra exceeds the 5 MB non-LFS limit.
METAGAME/Assets/Scenes/Stage1_Astra.unity filter=lfs diff=lfs merge=lfs -text

# Unity TerrainData is binary even though it uses the .asset extension.
METAGAME/Assets/_Project/Terrain/Stage1/TerrainData/*.asset -text
METAGAME/Assets/_Project/Terrain/Stage1/TerrainData/TD_Stage1_AstraBasin.asset filter=lfs diff=lfs merge=lfs -text

